DB_HOST=localhost
DB_PORT=5432
DB_NAME=delivery_tracker
DB_USERNAME=delivery
# Replace this placeholder with your own local password.
DB_PASSWORD=replace-with-a-local-password
JWT_ISSUER=delivery-tracker-api
JWT_PRIVATE_KEY=file:./secrets/private.pem
JWT_PUBLIC_KEY=file:./secrets/public.pem
JWT_TTL_SECONDS=3600
API_DOCS_ENABLED=true
# Optional; used only when the local profile is active. No operator is created by default.
# LOCAL_OPERATOR_EMAIL=operator@example.test
# LOCAL_OPERATOR_PASSWORD=
